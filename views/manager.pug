doctype html
html(lang="ko")
  head
    meta(charset="UTF-8")
    title 병원 관리자 화면
    link(rel='stylesheet', href='/stylesheets/style.css')

  body(onload="loadPendingUsers()")
    if session && session.user
      nav(style="text-align: right; margin: 10px")
        a(href="/auth/logout", style="text-decoration: none; color: red") 로그아웃

    h1 🏥 병원 관리자 페이지

    //- 병원 관리 섹션
    #managementSection
      h2 소속 승인 요청
      ul#pendingUsers

      h2 병원 정보 수정 요청
      form#updateForm
        input(type="text" id="name" placeholder="병원명")
        br
        input(type="text" id="address" placeholder="주소")
        br
        input(type="text" id="contact" placeholder="연락처")
        br
        button(type="submit") 수정 요청

      h2 병원 삭제 요청
      button(onclick="requestDelete()") 삭제 요청

    //- 스크립트 내장
    script.
      async function loadPendingUsers() {
        try {
          const res = await fetch('/manager/pending-users');
          const data = await res.json();
          const list = document.getElementById('pendingUsers');
          list.innerHTML = '';
          data.users.forEach(user => {
            const li = document.createElement('li');
            li.innerText = `(${user.email}) `;
            const btn = document.createElement('button');
            btn.innerText = '승인';
            btn.onclick = () => approveUser(user._id);
            li.appendChild(btn);
            list.appendChild(li);
          });
        } catch (err) {
          alert('승인 요청 목록을 불러오지 못했습니다.');
        }
      }

      async function approveUser(userId) {
        try {
          await fetch('/manager/approve-user/' + userId, { method: 'PATCH' }); // POST → PATCH 변경
          alert('승인 완료');
          loadPendingUsers();
        } catch (err) {
          alert('승인 실패');
        }
      }

      async function requestDelete() {
        if (!confirm('정말 병원을 삭제하시겠습니까?')) return;
        try {
          await fetch('/manager/delete-hospital', { method: 'POST' });
          alert('삭제 요청 완료');
        } catch (err) {
          alert('삭제 요청 실패');
        }
      }

      document.getElementById('updateForm').addEventListener('submit', async (e) => {
        e.preventDefault();
        const name = document.getElementById('name').value;
        const address = document.getElementById('address').value;
        const contact = document.getElementById('contact').value;

        try {
          await fetch('/manager/update-hospital', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ name, address, contact })
          });
          alert('수정 요청 완료');
        } catch (err) {
          alert('수정 요청 실패');
        }
      });

      // 초기 로딩 시 병원 정보 확인
      window.onload = loadPendingUsers();